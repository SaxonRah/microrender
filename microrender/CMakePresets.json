{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "game",
      "displayName": "Pico 2: game demo, DMA-pipelined",
      "description": "Replaces set_pico_game_build.py. Configuration lives here, not in rewritten source.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "MR_APP": "GAME",
        "MR_TILE_H": "240",
        "MR_GAME_PRESENTATION": "pipelined",
        "MR_SCREEN_W": "320",
        "MR_SCREEN_H": "240"
      },
      "generator": "Ninja"
    },
    {
      "name": "game-raw",
      "inherits": "game",
      "displayName": "Pico 2: game demo, raw serialized baseline",
      "binaryDir": "${sourceDir}/build-game-raw",
      "cacheVariables": {
        "MR_GAME_PRESENTATION": "raw",
        "MR_PICO_FRAME_PIPELINE": "OFF",
        "MR_TILE_H": "240"
      }
    },
    {
      "name": "stress-visible",
      "inherits": "game",
      "displayName": "Pico 2: stress test, full flush every frame",
      "binaryDir": "${sourceDir}/build-stress-visible",
      "cacheVariables": {
        "MR_APP": "STRESS",
        "MR_STRESS_MODE": "visible",
        "MR_STRESS_SPRITES": "512"
      }
    },
    {
      "name": "stress-raw",
      "inherits": "stress-visible",
      "displayName": "Pico 2: stress test, raw clear/draw/send loop",
      "binaryDir": "${sourceDir}/build-stress-raw",
      "cacheVariables": {
        "MR_STRESS_MODE": "raw",
        "MR_PICO_FRAME_PIPELINE": "OFF",
        "MR_TILE_H": "240",
        "MR_STRESS_SPRITES": "512"
      }
    },
    {
      "name": "stress-lace",
      "inherits": "stress-visible",
      "displayName": "Pico 2: stress test, temporal row groups (fast)",
      "binaryDir": "${sourceDir}/build-stress-lace",
      "cacheVariables": {
        "MR_STRESS_MODE": "lace",
        "MR_STRESS_SPRITES": "1024",
        "MR_STRESS_LACE_BLOCK_H": "8",
        "MR_PICO_SYS_KHZ": "300000",
        "MR_LCD_SPI_BAUD": "75000000",
        "MR_PICO_PRESENT_CORE1": "ON"
      }
    },
    {
      "name": "stress-render",
      "inherits": "stress-visible",
      "displayName": "Pico 2: stress raster path, LCD flush disabled",
      "binaryDir": "${sourceDir}/build-stress-render",
      "cacheVariables": {
        "MR_STRESS_MODE": "render",
        "MR_STRESS_SPRITES": "1024",
        "MR_STRESS_PICO_SERIAL": "ON"
      }
    },
    {
      "name": "stress-dirtyrect",
      "inherits": "stress-visible",
      "displayName": "Pico 2: coalesced dirty-rectangle flush",
      "binaryDir": "${sourceDir}/build-stress-dirtyrect",
      "cacheVariables": {
        "MR_STRESS_MODE": "dirtyrect",
        "MR_TILE_H": "16",
        "MR_STRESS_SPRITES": "512"
      }
    },
    {
      "name": "game-st7796s",
      "inherits": "game",
      "displayName": "Pico 2: ST7796S 480x320 game demo",
      "binaryDir": "${sourceDir}/build-game-st7796s",
      "cacheVariables": {
        "MR_LCD_PANEL": "ST7796S",
        "MR_SCREEN_W": "480",
        "MR_SCREEN_H": "320",
        "MR_VIEW_H": "320",
        "MR_TILE_H": "16",
        "MR_ILI9341_MADCTL": "0xE8"
      }
    },
    {
      "name": "stress-visible-st7796s",
      "inherits": "game-st7796s",
      "displayName": "Pico 2: ST7796S 480x320 full visible stress",
      "binaryDir": "${sourceDir}/build-stress-visible-st7796s",
      "cacheVariables": {
        "MR_APP": "STRESS",
        "MR_STRESS_MODE": "visible",
        "MR_STRESS_SPRITES": "512"
      }
    },
    {
      "name": "stress-lcdtest-st7796s",
      "inherits": "game-st7796s",
      "displayName": "Pico 2: ST7796S 480x320 LCD transfer test",
      "binaryDir": "${sourceDir}/build-stress-lcdtest-st7796s",
      "cacheVariables": {
        "MR_APP": "STRESS",
        "MR_STRESS_MODE": "lcdtest",
        "MR_STRESS_SPRITES": "1",
        "MR_TILE_H": "16",
        "MR_STRESS_PICO_SERIAL": "ON"
      }
    },
    {
      "name": "stress-raw-st7796s",
      "inherits": "game-st7796s",
      "displayName": "Pico 2: ST7796S 480x320 raw full-frame baseline",
      "binaryDir": "${sourceDir}/build-stress-raw-st7796s",
      "cacheVariables": {
        "MR_APP": "STRESS",
        "MR_STRESS_MODE": "raw",
        "MR_PICO_FRAME_PIPELINE": "OFF",
        "MR_TILE_H": "320",
        "MR_STRESS_SPRITES": "512",
        "MR_STRESS_PICO_SERIAL": "ON"
      }
    },
    {
      "name": "stress-lace-st7796s",
      "inherits": "game-st7796s",
      "displayName": "Pico 2: ST7796S 480x320 2-phase temporal row groups",
      "binaryDir": "${sourceDir}/build-stress-lace-st7796s",
      "cacheVariables": {
        "MR_APP": "STRESS",
        "MR_STRESS_MODE": "lace",
        "MR_STRESS_SPRITES": "512",
        "MR_TILE_H": "320",
        "MR_STRESS_LACE_BLOCK_H": "8",
        "MR_STRESS_LACE_PHASES": "2",
        "MR_PICO_SYS_KHZ": "300000",
        "MR_LCD_SPI_BAUD": "75000000",
        "MR_PICO_PRESENT_CORE1": "OFF",
        "MR_STRESS_PICO_SERIAL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "game",
      "configurePreset": "game"
    },
    {
      "name": "game-raw",
      "configurePreset": "game-raw"
    },
    {
      "name": "stress-visible",
      "configurePreset": "stress-visible"
    },
    {
      "name": "stress-raw",
      "configurePreset": "stress-raw"
    },
    {
      "name": "stress-lace",
      "configurePreset": "stress-lace"
    },
    {
      "name": "stress-render",
      "configurePreset": "stress-render"
    },
    {
      "name": "stress-dirtyrect",
      "configurePreset": "stress-dirtyrect"
    },
    {
      "name": "game-st7796s",
      "configurePreset": "game-st7796s"
    },
    {
      "name": "stress-visible-st7796s",
      "configurePreset": "stress-visible-st7796s"
    },
    {
      "name": "stress-lcdtest-st7796s",
      "configurePreset": "stress-lcdtest-st7796s"
    },
    {
      "name": "stress-raw-st7796s",
      "configurePreset": "stress-raw-st7796s"
    },
    {
      "name": "stress-lace-st7796s",
      "configurePreset": "stress-lace-st7796s"
    }
  ]
}
