{
    "configurations": [
        {
            "name": "Pico",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/../shared/src",
                "${workspaceFolder}/../shared/rp2350",
                "${workspaceFolder}/../shared/generated"
            ],
            "defines": [
                "PICO_BOARD=pimoroni_pico_plus2_rp2350",
                "GFX_PLATFORM_RP2350=1",
                "MR_STRESS_TEST=1"
            ],
            "compilerPath": "${userHome}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/../shared"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
